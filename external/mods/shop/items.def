;Shop Items declaration. Assigned items are purchasable via Shop Mode
;submenu ('menu.itemname.shop' parameter in screenpack DEF file)

;Declaring shop items consists of setting up following parameters:

; - [Category Name] (required)
;	Set to name that will be used to group items into Categories.
;	Currently the only Category Names recognized by default are:
;	"Characters"/"Chars" or "Costumes", "Colors" or "Palettes" and "Stages".
;
;	Unrecognized names will be considered as "Custom Categories".
;	(Ideal for use with modules or just to buy content not added by default in the engine).
;
;	To change categories in the shop menu, use the "menu.nextcategory.key" and "menu.previouscategory.key"
;	defined in the [Shop Info] section of shopMenu.def.
 
; - id (required)
;	Set to name that initiates new shop items declaration, so it has to be assigned
;	before any other parameter used by the same item and inside [Category Name] previously declared.
;	(All shop items should have unique id names and should be written in lowercase).
;
;	Characters and Stages id is the same text line added to load them in select.def (but using lowercase).
;	(Unrecognized chars or stages IDs, will be excluded from the shop).
;
;	The id stored will be used by "unlock" paramvalue following the next format:
;	unlock=(shopDat.shopstock ~= nil and shopDat.shopstock["categoryname"] ~= nil and shopDat.shopstock["categoryname"]["itemid"] == false) or netPlay()
;
;	This means that any engine feature that uses the "unlock" paramvalue
;	can use this Shop Mode to create a purchasable item as an unlock condition.

; - price (optional)
;	Set to number that should be displayed as price value for each item.
;	If is not defined, "price.default" shopMenu.def [Shop Info] paramvalue will be used.

; - unlock (optional)
;   Pure Lua code, executed exactly as is, each time upon loading shop menu.
;   If it evaluates to boolean 'true' the item will be selectable from
;   shop submenu, or hidden on 'false'. Default: true.
;   https://github.com/ikemen-engine/Ikemen-GO/wiki/Lua#content-unlocking

; - info (optional)
;   Set to custom description that should be displayed for item selected.
;   If is not defined, "info.unlock" shopMenu.def [Shop Info] paramvalue + item name will be used.

; - char (only used in colors category) [optional]
;	Set to character path (the same text line added to load him in select.def, using lowercase)
;	to load a character preview that will have the color defined applied.

; - color (only used in colors category) [optional]
;	Set to number of the color palette that will be applied to the character id preview.

; - name (only used in custom category) [optional]
;	Set to name that should be displayed for each item stored in a "Custom Category".
;	If is not defined, "info.unknown" shopMenu.def [Shop Info] paramvalue will be used.

; - spr (only used in custom category) [optional]
;	Set groupNo and indexNo to load from the sff file defined in "items.spr" shopMenu.def
;	[Shop Info] paramvalue, to show a preview sprite for items stored in a "Custom Category".
;	If is not defined, nothing will be displayed.
;
;	Characters and Stages previews are read from their own .sff file and configured
;	in shopMenu.def [Shop Info] with "character.preview" and "stage.preview" paramvalues.

; - offset (only used in custom category) [optional]
;	Set posX and posY for each item stored in a "Custom Category" defined in "items.spr"
;	shopMenu.def [Shop Info] paramvalue.
;	If is not defined, custom.preview.offset shopMenu.def [Shop Info] paramvalue will be used.

; - scale (only used in custom category) [optional]
;	Set scaleX and scaleY for each item stored in a "Custom Category" defined in "items.spr"
;	shopMenu.def [Shop Info] paramvalue.
;	If is not defined, custom.preview.scale shopMenu.def [Shop Info] paramvalue will be used.

; - window (only used in custom category) [optional]
;	Set the drawing window for each item stored in a "Custom Category" defined in "items.spr"
;	shopMenu.def [Shop Info] paramvalue. x1, y1 are the x,y coordinates of the upper left of the window,
;	while x2, y2 represents the lower right. Anything drawn outside this window will not be seen.
;	If is not defined, custom.preview.window shopMenu.def [Shop Info] paramvalue will be used.
;Examples:

[Characters]
id = kfm720
price = 2500

id = kfm_zaxis
price = 5000
unlock = shopDat.shopstock ~= nil and shopDat.shopstock["Stages"] ~= nil and shopDat.shopstock["Stages"]["stages/stagez.def"] == false

[Colors]
id = kfmpal3
char = kfm_zss
color = 3

id = kfmpal4
char = kfm_zss
color = 4

id = kfmpal5
char = kfm_zss
color = 5

id = kfmpal13
char = kfm_zss
color = 13
price = 800
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and stats.modes.arcade.clearcount.kfm ~= nil

id = kfmpal14
char = kfm_zss
color = 14
price = 800
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and stats.modes.arcade.clearcount.kfm ~= nil

id = kfmpal15
char = kfm_zss
color = 15
price = 1000
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and stats.modes.arcade.clearcount.kfm ~= nil

[Stages]
id = stages/kfm.def

id = stages/stage0-720.def
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and stats.modes.arcade.clearcount.kfm720 ~= nil

id = stages/stagez.def
price = 1500

id = stages/stage3d.def
price = 2000

;The next example is a "Custom Category" that is compatible with the following external module:
;https://github.com/CableDorado2/IkemenGO-GameModes-Tweaks/tree/main/external/mods/gallery
[Artworks]
id = art4
name = Kung Fu Man
info = Esaka's Kung Fu Man Artwork will be available in Gallery.
price = 1800
spr = 1,0
offset = 780,64
scale = 0.64, 0.64
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and stats.modes.arcade.clearcount.kfm720 ~= nil