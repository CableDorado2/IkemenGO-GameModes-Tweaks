preview.unknown.facing = 1
preview.unknown.scale = 1.03, 1.1
preview.unknown.window = 0,0, 320,240

character.preview.resetanim = 0 ;Set to 1 to Reset Character Preview Animation when move cursor.
character.preview.anim = 0 ;By default it uses stand animation, but if you want to use a exclusive one, read the note in the shop.lua file.
;character.preview.spr = 9000,1 ;You have to choose between anim or spr(portrait)
character.preview.offset = 238,184
character.preview.facing = 1
character.preview.scale = 1.0, 1.0
character.preview.window = 0,0, 320,240

stage.preview.resetanim = 0 ;Set to 1 to Reset Stage Preview Animation when move cursor.
;stage.preview.anim = -1 ;You have to choose between anim or spr(portrait)
stage.preview.spr = 9000,1 ;By default it uses stage select portrait, but if you want to use a exclusive one, read the note in the shop.lua file.
stage.preview.offset = 163,31
stage.preview.facing = 1
stage.preview.scale = 0.63, 1.68
stage.preview.window = 0,0, 320,240

custom.preview.offset = 160,20
custom.preview.scale = 1.0, 1.0
custom.preview.window = 0,0, 320,240

menu.item.offset = 5,61
menu.item.font = 2,0,1
menu.item.scale = 1.0, 1.0
menu.item.spacing = 0,15 ;active items also uses this

menu.item.active.offset = 5,61
