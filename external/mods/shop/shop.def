;Copy whatever you need to your system.def file.
;This file is not loaded by the engine, so you can delete it.

[Music]
;Music to play at shop mode screen.
shop.bgm = ""
shop.bgm.volume = 100
shop.bgm.loop = 1
shop.bgm.loopstart = 0
shop.bgm.loopend = 0

[Title Info]
;Shop Mode
menu.itemname.shop = "SHOP" ;Ikemen feature

;------------------------------------------------------------------------------------------------------------------
;FOR SCREENPACKS BASED IN DEFAULT WINMUGEN MOTIF (localcoord = 320,240):
;------------------------------------------------------------------------------------------------------------------
[Shop Info] ;Shop screen definition
reload.enabled = 0 ;Set to 1 to enable shop data reload (items.def & items.sff files), each time that shop menu is initialized (for debug purposes), 0 to disable.

fadein.time = 20
fadein.col = 0,0,0
;fadein.anim = -1

fadeout.time = 20
fadeout.col = 0,0,0
;fadeout.anim = -1

menu.uselocalcoord = 1
menu.pos = 0,0

cursor.move.snd = 100,0
cursor.category.snd = 100,0
cursor.done.snd = 100,1
cursor.purchase.snd = 600,0
cursor.error.snd = 600,1
cancel.snd = 100,2

title.offset = 5,15
title.font = 3,0,1
title.scale = 1.0, 1.0
title.text = "ITEM SHOP"

category.offset = 77,45
category.font = 3,5,0
category.scale = 1.0, 1.0

currency.offset = 318,15
currency.font = 3,0,-1
currency.scale = 1.0, 1.0
currency.text = "P$"

price.offset = 240,197
price.font = 3,0,0
price.scale = 1.0, 1.0
price.text.sold = "SOLD OUT"
price.default = 500 ;If a shop item does not have a price assigned, it will be assigned this price by default.

info.offset = 5,230
info.font = 2,0,1
info.scale = 0.95, 0.95
info.text.unknown = "???"
info.text.unlock = "Unlocks"
info.text.locked = "This item has yet to be discovered..."

items.def = external/mods/shop/items.def ;load the items to be sold.
items.spr = external/mods/shop/items.sff ;load sprites for shop items.

