[Info]
ikemenversion = 1.0
localcoord = 1280,720
;-------------------------------------------------------------------------------
[Files]
def = external/mods/shop/items.def ;load the Shop Items to be sold in Shop Menu. (If is not defined, nothing will be loaded)
sff = external/mods/shop/items.sff ;load sprites for Shop Items. (If is not defined, nothing will be displayed)
;air = external/mods/shop/items.air ;load animations for Shop Items. (If is not defined, animations will be loaded from system.def)
;snd = external/mods/shop/shop.snd ;load sounds for Shop Menu. (If is not defined, sounds will be loaded from system.def)
;-------------------------------------------------------------------------------
[Fonts] ;If are not defined, fonts will be loaded from system.def
font1 = f-4x6.def
font2 = ikemen1/fonts/Pixel.def
font3 = ikemen1/fonts/Menu2.def
font4 = ikemen1/fonts/Menu1.def
font5 = Open_Sans.def
font6 = infofont.def
font7 = Open_Sans.def
font8 = ikemen1/fonts/Timer.def
font9 = ikemen1/fonts/PixelFlat.def
;-------------------------------------------------------------------------------
[Music] ;Music to play at event mode screen.
menu.bgm = sound/system/Shop.mp3
menu.volume = 100
menu.loop = 1
menu.loopstart = 0
menu.loopend = 0
menu.startposition = 0
menu.freqmul = 1.0
menu.loopcount = -1
;-------------------------------------------------------------------------------
