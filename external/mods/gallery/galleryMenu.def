[Info]
ikemenversion = 1.0
localcoord = 1280,720
;-------------------------------------------------------------------------------
[Files]
common.sff = external/mods/gallery/common.sff ;load sprites for Gallery Menu. (If is not defined, nothing will be displayed)
;common.snd = external/mods/gallery/common.snd ;load sounds for Gallery Menu. (If is not defined, sounds will be loaded from system.def)

;Load the Gallery Items to show for each category in Gallery Menu. (If is not defined, nothing will be loaded)
artworks.def = external/mods/gallery/artworks.def
storyboards.def = external/mods/gallery/storyboards.def
music.def = external/mods/gallery/music.def

;Load sprites for each Gallery Items. (If is not defined, nothing will be displayed)
artworks.sff = external/mods/gallery/artworks.sff
storyboards.sff = external/mods/gallery/storyboards.sff
music.sff = external/mods/gallery/music.sff
;-------------------------------------------------------------------------------
[Fonts] ;If are not defined, fonts will be loaded from system.def
font1 = f-4x6.def
font2 = ikemen1/fonts/Pixel.def
font3 = ikemen1/fonts/Menu2.def
font4 = ikemen1/fonts/Menu1.def
font5 = Open_Sans.def
font6 = infofont.def
font7 = Open_Sans.def
font8 = ikemen1/fonts/Timer.def
font9 = ikemen1/fonts/PixelFlat.def

;-------------------------------------------------------------------------------
[Music] ;Music to play at gallery menu screen.
menu.bgm = sound/system/Gallery.mp3
menu.volume = 100
menu.loop = 1
menu.loopstart = 0
menu.loopend = 0
menu.startposition = 0
menu.freqmul = 1.0
menu.loopcount = -1
;-------------------------------------------------------------------------------
[Gallery Info] ;Gallery screen definition
reload.enabled = 0 ;Set to 1 to enable gallery data reload (.def & .sff files), each time that gallery menu is initialized (for debug purposes), 0 to disable.

fadein.time = 20
