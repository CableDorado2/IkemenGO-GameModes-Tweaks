;Copy whatever you need to your system.def file.
;This file is not loaded by the engine, so you can delete it.

[Music]
;Music to play at gallery mode screen.
gallery.bgm = ""
gallery.bgm.volume = 100
gallery.bgm.loop = 1
gallery.bgm.loopstart = 0
gallery.bgm.loopend = 0

[Title Info]
;Gallery Mode
menu.itemname.gallery = "GALLERY" ;Ikemen feature

;------------------------------------------------------------------------------------------------------------------
;FOR SCREENPACKS BASED IN DEFAULT WINMUGEN MOTIF (localcoord = 320,240):
;------------------------------------------------------------------------------------------------------------------
[Gallery Info] ;Gallery screen definition
reload.enabled = 0 ;Set to 1 to enable gallery data reload (.def & .sff files), each time that gallery menu is initialized (for debug purposes), 0 to disable.

