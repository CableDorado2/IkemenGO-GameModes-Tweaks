;This file is not loaded by the engine, so you can delete it.
;This was made just for you <3 copy whatever you need to your system.def file.

[Music]
;Music to play at gallery mode screen.
gallery.bgm = ""
gallery.bgm.volume = 100
gallery.bgm.loop = 1
gallery.bgm.loopstart = 0
gallery.bgm.loopend = 0

[Title Info]
;Gallery Mode
menu.itemname.gallery = "GALLERY" ;Ikemen feature

