;Gallery Artworks declaration. Assigned artworks are selectable via Gallery Mode
;submenu ('menu.itemname.gallery' parameter in screenpack DEF file)

;Declaring artworks consists of setting up following parameters:
 
; - id (required)
;	Set to name that should be stored for use with unlocks paramvalue.
;	This parameter also initiates new artworks declaration, so it has to be
;	assigned before any other parameter used by the same artwork.
;	All artworks should have unique id names.

; - spr (required)
;	Set groupNo and indexNo to load from sff file defined in "artworks.sff"
;	galleryMenu.def [Files] paramvalue, to show sprite for items.
;	If is not defined, "cell.unknown.spr" will be displayed.

; - size (optional)
;	Set Width and Height of sprite defined in spr paramvalue.
;	If is not defined, "art.size" galleryMenu.def [ArtViewer Info] paramvalue will be used.

; - pos (only used in artwork viewer) [optional]
;	Set posX and posY for sprite defined in spr paramvalue.
;	If is not defined, "art.offset" galleryMenu.def [ArtViewer Info] paramvalue will be used.

; - scale (only used in artwork viewer) [optional]
;	Set scaleX and scaleY for sprite defined in spr paramvalue.
;	If is not defined, "art.scale" galleryMenu.def [ArtViewer Info] paramvalue will be used.

; - zoomlimit (only used in artwork viewer) [optional]
;	Set maxZoomOut and maxZoomIn for sprite defined in spr paramvalue.
;	If is not defined, "art.zoomlimit" galleryMenu.def [ArtViewer Info] paramvalue will be used.

; - movelimit (only used in artwork viewer) [optional]
;	Set maxPosX1, maxPosY1, maxPosX2, maxPosY2 for sprite defined in spr paramvalue.
;	If is not defined, "art.movelimit" galleryMenu.def [ArtViewer Info] paramvalue will be used.

; - previewpos (only used in main gallery screen) [optional]
;	Set posX and posY for gallery preview sprite which is the same defined in spr paramvalue.
;	If is not defined, "cell.art.offset" galleryMenu.def [Gallery Info] paramvalue will be used.

; - previewspacing (only used in main gallery screen) [optional]
;	Set spacingX and spacingY for gallery preview sprite which is the same defined in spr paramvalue.
;	If is not defined, "cell.art.spacing" galleryMenu.def [Gallery Info] paramvalue will be used.

; - previewscale (only used in main gallery screen) [optional]
;	Set scaleX and scaleY for gallery preview sprite which is the same defined in spr paramvalue.
;	If is not defined, "cell.art.scale" galleryMenu.def [Gallery Info] paramvalue will be used.

; - info (optional)
;	Set to description that should be displayed for artwork selected.
;	If is not defined, "info.unknown" galleryMenu.def [Gallery Info] paramvalue will be used.

; - unlock (optional)
;	Pure Lua code, executed exactly as is, each time upon loading gallery menu.
;	If it evaluates to boolean 'true' the artwork will be selectable from
;	gallery mode submenu, or hidden on 'false'. Default: true.
;	https://github.com/ikemen-engine/Ikemen-GO/wiki/Lua#content-unlocking

;Examples:
 
[GalleryArtworks]
id = Art 1
spr = 1,1
size = 600, 800
scale = 0.3, 0.3
zoomlimit = 0.20, 1.20
info = Unofficial Artwork 1 of Kung Fu Man By act52
previewspacing = -285,-604
previewscale = 0.2, 0.186

id = Art 2
spr = 1,2
size = 779, 1800
pos = 159,135
scale = 0.15, 0.15
zoomlimit = 0.10, 0.65
info = Unofficial Artwork of Suave Dude By Koorogi
previewspacing = -464,-1604
previewscale = 0.09, 0.083

id = Art 3
spr = 1,3
size = 352, 640
scale = 0.38, 0.38
zoomlimit = 0.30, 0.80
info = Unofficial Artwork 2 of Kung Fu Man By act52
previewspacing = -37,-444
previewscale = 0.215, 0.227
unlock = stats.modes ~= nil and stats.modes.arcade ~= nil and stats.modes.arcade.clearcount ~= nil and (stats.modes.arcade.clearcount.kfmz ~= nil or stats.modes.arcade.clearcount.kfm_zss ~= nil)

id = Art 4
spr = 1,4
size = 600, 800
scale = 0.30, 0.30
zoomlimit = 0.26,1.30
movelimit = -320,-480, 470,600
info = Unofficial Artwork of Kung Fu Man By Esaka
previewspacing = -285,-604
previewscale = 0.2, 0.186
unlock = stats.shopstock ~= nil and stats.shopstock["Artworks"] ~= nil and stats.shopstock["Artworks"]["art4"] == false
;The above unlock condition example is compatible with the following external module:
;https://github.com/CableDorado2/IkemenGO-GameModes-Tweaks/tree/main/external/mods/shop

;Note:
;It is recommended avoid to use some paramvalues ​​in this file for those images that share the same size/dimensions.
;So instead of adding custom values for each (except: id, spr, info and unlock) use the COMMON VALUES that are
;read from galleryMenu.def, according to the description of what happens "if not defined".

;Recommended Artworks Resolution for quick add with default module settings: 1280x720

id = Art 5
spr = 1,5
size = 1787,873
pos = 159,116
scale = 0.23, 0.23
zoomlimit = 0.10, 0.65
info = Ikemen GO v1.0 "Release Date" Artwork By Ohmga Shironeko
previewspacing = -1472,-677
previewscale = 0.155, 0.17

id = Art 6
;spr = group,index

id = Art 7
